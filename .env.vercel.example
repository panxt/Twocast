# Set NEXT_PUBLIC_SITE_URL to the Vercel deployment URL, including https://.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_VERCEL_BETA=1
INVITE_REQUIRED=1

# Use the Supabase transaction pooler with the restricted twocast_app role.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Generate once and retain securely. Admin code redeems an admin session;
# settings key is base64 of 32 random bytes.
BOOTSTRAP_ADMIN_CODE=
SETTINGS_ENCRYPTION_KEY=

# Enable only MiniMax for this private beta. Configure its credentials,
# LLM endpoint/model/key in /settings after redeeming the admin code.
MINIMAX_ENABLED=1
FISH_AUDIO_ENABLED=0
GEMINI_ENABLED=0
MOCK_ENABLED=
